# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Origin of the React app (used for CORS). Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────
# Local MongoDB or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/repolens

# ─── Auth ──────────────────────────────────────────────────
# REQUIRED. Use a long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── GitHub ────────────────────────────────────────────────
# Optional but strongly recommended. Without a token GitHub allows only
# 60 API requests/hour per IP. A fine-grained token with NO scopes
# (public repositories only) raises that to 5,000/hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Advanced: override GitHub endpoints (e.g. GitHub Enterprise or a local mock).
# GITHUB_API_URL=https://api.github.com
# GITHUB_RAW_URL=https://raw.githubusercontent.com
